# Portal do Credor — root env (usado por deploy/docker-compose.yml via env_file: ../.env)
# Copie para .env na raiz: cp .env.example .env
# Nunca commite .env (AGENTS.md "Never do" 1)

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost
CORS_ORIGIN=http://localhost:3001

# Postgres (deploy/postgres)
POSTGRES_DB=case_adm
POSTGRES_USER=case_adm
POSTGRES_PASSWORD=case_adm_dev
# Password of the least-privilege application role (case_adm_app), created by
# deploy/postgres-init on first initialization. Dev value only — production
# takes it from secrets (see .agents/decisions/database.md).
POSTGRES_APP_PASSWORD=case_adm_app_dev

# Prisma — the app connects as case_adm_app (DML only); migrations connect as
# the owner via DIRECT_URL. Never point DATABASE_URL at a superuser in prod.
DATABASE_URL=postgresql://case_adm_app:case_adm_app_dev@postgres:5432/case_adm?schema=public
DIRECT_URL=postgresql://case_adm:case_adm_dev@postgres:5432/case_adm?schema=public

# Auth (32+ chars em prod)
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars

# Storage — SeaweedFS S3 (privado)
SEAWEEDFS_ENDPOINT=http://seaweedfs:8333
SEAWEEDFS_BUCKET_DOCUMENTS=documents
SEAWEEDFS_ACCESS_KEY=admin
SEAWEEDFS_SECRET_KEY=admin

# Email — Mailpit em dev (1025 SMTP, 8025 UI), prod use SMTP real
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Sender shown on transactional mail. Generic placeholder — set the real
# address before production.
SMTP_FROM=nao-responda@case.local
SMTP_FROM_NAME=Portal do Credor

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api/v1
BACKEND_INTERNAL_URL=http://backend:3000

# Copy to .env — never commit .env
NODE_ENV=development
PORT=3000

# Least-privilege app role — DML only
DATABASE_URL=postgresql://case_adm:case_adm_dev@localhost:5432/case_adm?schema=public
# Privileged role — used only for `prisma migrate deploy`
DIRECT_URL=postgresql://case_adm:case_adm_dev@localhost:5432/case_adm?schema=public

JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars

SEAWEEDFS_ENDPOINT=http://localhost:8333
SEAWEEDFS_BUCKET_DOCUMENTS=documents
SEAWEEDFS_BUCKET_AVATARS=avatars
SEAWEEDFS_ACCESS_KEY=admin
SEAWEEDFS_SECRET_KEY=admin

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

APP_URL=http://localhost
CORS_ORIGIN=http://localhost:3001
